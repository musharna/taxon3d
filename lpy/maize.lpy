import openalea.plantgl.all as pgl
from math import pi

# Authored maize (Zea mays) L-system for bio3d-arena — Track B LLM-synth slice.
# Monocot grass: single unbranched culm, long broad arching strap leaves in 2 opposite ranks
# (distichous, 180° phyllotaxy), a terminal tassel (staminate panicle), and a lateral ear.


def strap_leaf(length, width, arch=0.32):
    """A long broad arching maize blade. Midrib along +X, blade in XY (normal +Z), tip drooping
    (−Z), broad near the base and tapering to a point — built as a triangle strip between
    consecutive cross-sections (clean long blade, not a fan)."""
    n = 18
    pts = [pgl.Vector3(0.0, 0.0, 0.0)]  # 0 = base midrib point
    for i in range(1, n + 1):
        t = i / n
        x = length * t
        z = -arch * length * (t * t)  # progressive downward arch toward the tip
        w = width * max(0.0, (1.0 - abs(t - 0.30) / 0.85)) ** 0.7  # broad mid → pointed tip
        pts.append(pgl.Vector3(x, w, z))  # left edge  (odd index)
        pts.append(pgl.Vector3(x, -w, z))  # right edge (even index)
    idx = []
    # base fan: point 0 to the first cross-section
    idx += [pgl.Index3(0, 1, 2)]
    for i in range(1, n):
        l0, r0 = 2 * i - 1, 2 * i
        l1, r1 = 2 * i + 1, 2 * i + 2
        idx += [pgl.Index3(l0, l1, r1), pgl.Index3(l0, r1, r0)]
    ts = pgl.TriangleSet(pts, idx)
    ts.computeNormalList()
    return ts


def tassel(scale=1.0):
    """Terminal staminate panicle: a central spike + several arching side branches of thin
    spikelets. Reads as the wispy male flower atop the culm."""
    shapes = [pgl.Cylinder(0.05 * scale, 5.5 * scale, slices=4)]  # central spike (+Z)
    branches = 7
    for k in range(branches):
        a = k * (2 * pi / branches)
        h = 1.2 * scale + 0.45 * scale * k
        br = pgl.Cylinder(0.035 * scale, 3.0 * scale, slices=3)
        placed = pgl.Translated(
            0, 0, h, pgl.AxisRotated((0, 0, 1), a, pgl.AxisRotated((0, 1, 0), 0.7, br))
        )
        shapes.append(placed)
    return pgl.Group(shapes)


def ear(scale=1.0):
    """A husked ear: a tapered cylinder with a short silk tuft, borne in a leaf axil."""
    husk = pgl.Cylinder(1.1 * scale, 4.2 * scale, slices=10)
    tip = pgl.Translated(0, 0, 4.2 * scale, pgl.Cone(1.1 * scale, 1.6 * scale, slices=10))
    silk = pgl.Translated(0, 0, 5.4 * scale, pgl.Cylinder(0.04 * scale, 1.6 * scale, slices=3))
    return pgl.Group([husk, tip, silk])


module Apex(n)

# Turtle default heading +H = +Z (up the culm). _(w) sets culm radius; ,(c) sets colour index
# (lpy_runner maps 2→leaf, 3→fruit/ear, 5→stem).
Axiom: _(1.4) ,(5) Apex(11)

derivation length: 11
production:

Apex(n):
  if n <= 0:
    # terminal tassel atop the culm — prominent staminate panicle
    produce [ ,(2) @g(tassel(1.7)) ]
  else:
    # thick visible culm internode (taper the radius up the stalk); distichous 180° phyllotaxy
    nproduce ,(5) _(1.3 * (0.5 + n / 22.0)) F(7.0) /(180)
    # long broad arching strap leaf (shallow arch so it reads as a long strap, not a stub)
    nproduce [ &(52) ,(2) /(90) @g(strap_leaf(28.0 * (0.55 + n / 22.0), 3.2, arch=0.18)) ]
    # a single husked ear borne in a mid-culm axil
    if n == 5:
      nproduce [ +(35) ,(3) F(2.0) [ &(80) @g(ear(1.5)) ] ]
    produce Apex(n - 1)
